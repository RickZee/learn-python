   "source": [
    "# Web applications\n",
    "\n",
    "A tiny router returns the body for a path.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "4f0a2e9c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(200, 'home')\n",
      "(404, 'missing')\n"
     ]
    }
   ],
   "source": [
    "routes = {\"/\": \"home\", \"/health\": \"ok\"}\n",
    "\n",
    "\n",
    "def handle(path: str) -> tuple[int, str]:\n",
    "    if path not in routes:\n",
    "        return 404, \"missing\"\n",
    "    return 200, routes[path]\n",
    "\n",
    "\n",
    "print(handle(\"/\"))\n",
    "print(handle(\"/missing\"))"
   ]
  }
 ],
