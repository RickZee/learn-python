   "source": [
    "# Cloud and operations\n",
    "\n",
    "The handler greets the name in the event.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "aaadbbc9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'statusCode': 200, 'body': 'hello ada'}\n",
      "{'statusCode': 200, 'body': 'hello there'}\n"
     ]
    }
   ],
   "source": [
    "def handler(event: dict, context=None) -> dict:\n",
    "    name = event.get(\"name\") or \"there\"\n",
    "    return {\"statusCode\": 200, \"body\": f\"hello {name}\"}\n",
    "\n",
    "\n",
    "print(handler({\"name\": \"ada\"}))\n",
    "print(handler({}))"
   ]
  }
 ],
