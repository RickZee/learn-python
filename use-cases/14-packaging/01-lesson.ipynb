   "source": [
    "# Packaging and distribution\n",
    "\n",
    "tomllib reads the project name and requires.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0e744c75",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "greet ['httpx']\n"
     ]
    }
   ],
   "source": [
    "import tomllib\n",
    "\n",
    "text = b\"\"\"\n",
    "[project]\n",
    "name = \"greet\"\n",
    "version = \"0.1.0\"\n",
    "dependencies = [\"httpx\"]\n",
    "\"\"\"\n",
    "project = tomllib.loads(text.decode())[\"project\"]\n",
    "print(project[\"name\"], project[\"dependencies\"])\n"
   ]
  }
 ],
