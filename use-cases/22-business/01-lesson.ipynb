   "source": [
    "# Business and finance\n",
    "\n",
    "0.1 + 0.2 is not 0.3 as a float. Decimal adds them exactly.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "268b0b25",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.30000000000000004\n",
      "0.3\n"
     ]
    }
   ],
   "source": [
    "from decimal import Decimal\n",
    "\n",
    "print(0.1 + 0.2)\n",
    "print(Decimal(\"0.1\") + Decimal(\"0.2\"))"
   ]
  }
