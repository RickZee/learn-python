   "source": [
    "def step(position: int, action: str) -> int:\n",
    "    if action == \"right\":\n",
    "        return position + 1\n",
    "    return position\n",
    "\n",
    "\n",
    "print(step(3, \"right\"), step(3, \"wait\"))\n"
   ]
  }
