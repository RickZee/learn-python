   "source": [
    "# Command-line applications\n",
    "\n",
    "argparse reads a fake argument list and reports the name it was given.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "eef4a5d4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ada\n"
     ]
    }
   ],
   "source": [
    "import argparse\n",
    "\n",
    "parser = argparse.ArgumentParser(description=\"Greet one person\")\n",
    "parser.add_argument(\"name\")\n",
    "args = parser.parse_args([\"ada\"])\n",
    "print(args.name)\n"
   ]
  }
