   "source": [
    "# Scientific computing\n",
    "\n",
    "The slope of x squared near 3 is about 6.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "a22675df",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "6.0\n"
     ]
    }
   ],
   "source": [
    "def slope(fn, x: float, step: float = 1e-4) -> float:\n",
    "    return (fn(x + step) - fn(x - step)) / (2 * step)\n",
    "\n",
    "\n",
    "print(round(slope(lambda x: x * x, 3), 4))\n"
   ]
  }
 ],
